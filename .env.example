# URL pública /exec do Web App do Apps Script
APPS_SCRIPT_API_URL=https://script.google.com/macros/s/SEU_DEPLOYMENT_ID/exec

# Gere/rotacione pelo menu "Configurar ponte Vercel" no Apps Script.
# NUNCA coloque este valor no HTML ou no GitHub.
APPS_SCRIPT_PROXY_SECRET=configure_somente_na_vercel

# Token próprio do webhook configurado no painel do Asaas.
# NUNCA use a API key do Asaas como token de webhook.
ASAAS_WEBHOOK_TOKEN=configure_somente_na_vercel
